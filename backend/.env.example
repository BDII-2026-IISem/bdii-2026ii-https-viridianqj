# Copia este archivo a .env y reemplaza los valores. No subas .env a Git.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Motor activo: postgresql | mysql | mssql | oracle
DB_ENGINE=postgresql

# PostgreSQL
POSTGRES_DB=brasago_django
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_aqui
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# MySQL
MYSQL_DB=brasago_django
MYSQL_USER=root
MYSQL_PASSWORD=tu_password_aqui
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# SQL Server (requiere ODBC Driver 18 instalado en la máquina)
MSSQL_DB=brasago_django
MSSQL_USER=SA
MSSQL_PASSWORD=tu_password_aqui
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433

# Oracle (conexión por service name)
ORACLE_USER=brasago_django
ORACLE_PASSWORD=tu_password_aqui
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1

CORS_ALLOW_ALL_ORIGINS=True
